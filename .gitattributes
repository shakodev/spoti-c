# Preserve the bytes covered by the upstream SHA-256 manifests on every OS.
proto/** -text whitespace=cr-at-eol
# Upstream files retain their original whitespace as part of the pinned hashes.
proto/*.proto -whitespace
proto/**/*.proto -whitespace
proto/LICENSE.librespot -whitespace
vendor/nanopb/** -text -whitespace
vendor/shannon.c text eol=lf
vendor/shannon.h text eol=lf
vendor/licenses/shannon/** -text
tools/shannon_reference/** text eol=lf
tests/fixtures/shannon-vectors.json text eol=lf
tests/fixtures/crypto-vectors.json text eol=lf
tests/fixtures/decrypt/*.bin binary
tests/fixtures/decrypt/manifest.json text eol=lf
